class Calculator {
    // 1. Sum of two integers
    public int calculate(int a, int b) {
        return a + b;
    }

    // 2. Product of two doubles
    public double calculate(double a, double b) {
        return a * b;
    }

    // 3. Largest of three integers
    public int calculate(int a, int b, int c) {
        return Math.max(a, Math.max(b, c));
    }

    // 4. Difference as a double
    public double calculate(int a, double b) {
        return a - b;
    }
}

public class Main {
    public static void main(String[] args) {
        Calculator calc = new Calculator();

        System.out.println("Sum (10, 20): " + calc.calculate(10, 20));
        System.out.println("Product (2.5, 4.0): " + calc.calculate(2.5, 4.0));
        System.out.println("Largest (15, 42, 28): " + calc.calculate(15, 42, 28));
        System.out.println("Difference (50, 12.5): " + calc.calculate(50, 12.5));
    }
}
